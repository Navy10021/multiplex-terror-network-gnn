@prefix : <http://example.org/terror#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:ActorRoleShape a sh:NodeShape ;
    sh:targetClass :Actor ;
    sh:property [
        sh:path :hasRole ;
        sh:minCount 1 ;
        sh:maxCount 5 ;
    ] .

:FinanceEdgeAmountShape a sh:NodeShape ;
    sh:targetClass :FinanceRelation ;
    sh:property [
        sh:path :txnAmountSum ;
        sh:datatype xsd:float ;
        sh:minExclusive 0 ;
    ] .

:HierarchyNoSelfLoopShape a sh:NodeShape ;
    sh:targetClass :HierarchyRelation ;
    sh:sparql [
        sh:message "Hierarchy edges must not be self loops." ;
        sh:select """
            SELECT $this
            WHERE {
                $this :source ?s ;
                      :target ?t .
                FILTER(?s = ?t)
            }
        """ ;
    ] .

:EventTimeShape a sh:NodeShape ;
    sh:targetClass :Event ;
    sh:property [
        sh:path :timestamp ;
        sh:datatype xsd:int ;
        sh:minInclusive 0 ;
    ] .
